// Chaleur — BGM loop (énergie)
// Coller TOUT dans https://strudel.cc → Play (Ctrl+Entrée)
// Mute: _kick: etc.
//
// Export loop: 140 BPM · 8 mesures = 13.714… s
// → Duration 13.714 (ou 27.429 = 2 boucles) · WAV · pas MP3
// Pour joint seamless: exporte 2 boucles, coupe le milieu dans Audacity

setcps(140 / 60 / 4)

kick: note("c2")
  .s("sine")
  .struct("x ~ x ~ x x ~ x")
  .decay(0.12)
  .sustain(0)
  .shape(0.7)
  .gain(1.05)

snare: note("~ c4 ~ c4")
  .s("triangle")
  .hpf(2000)
  .decay(0.07)
  .sustain(0)
  .shape(0.45)
  .gain(0.65)

// Ghost notes entre les snares
rim: note("~ ~ c5 ~ ~ c5 c5 ~")
  .s("triangle")
  .hpf(4000)
  .decay(0.03)
  .sustain(0)
  .gain(0.28)

hats: note("c6*16")
  .s("triangle")
  .hpf(8500)
  .decay(0.018)
  .sustain(0)
  .gain("<0.22 0.35>*8")

open: note("~ ~ ~ c5")
  .s("triangle")
  .hpf(6000)
  .decay(0.2)
  .sustain(0)
  .gain(0.22)
  .room(0.2)

// Basse moteur — gallop + montée de chaleur
motor: note("<a1 a1 c2 a1  a1 e1 g1 a1>*8")
  .s("sawtooth")
  .lpf(sine.range(500, 1400).slow(8))
  .shape(0.35)
  .gain(0.8)
  .clip(0.85)

// Octave basse en syncopé
motor2: note("<a2 ~ c3 ~  a2 e2 ~ g2>*4")
  .s("square")
  .lpf(1200)
  .decay(0.15)
  .sustain(0)
  .gain(0.35)

// Accords — plus de coups, plus haut
kerb: note("<[a3,c4,e4] [a3,c4,e4] [a3,c4,f4] [a3,c4,e4] [g3,b3,d4] [g3,b3,d4] [e3,g3,b3] [a3,c4,e4]>")
  .s("sawtooth")
  .struct("x ~ x x ~ x ~ x")
  .lpf(2200)
  .decay(0.18)
  .sustain(0.08)
  .gain(0.42)
  .room(0.2)

// Stabs rouges — chaque mesure
heat: note("<[a4,c5] ~ e4 ~  [c5,e5] ~ g4 ~>*2")
  .s("sawtooth")
  .lpf(2800)
  .decay(0.22)
  .sustain(0)
  .gain(0.5)
  .room(0.25)

// Hook plus agressif, syncopé
line: note("<[a4 c5 ~ e5] [~ g4 a4 ~] [c5 ~ e5 g5] [a4 ~ ~ e5] [a4 ~ c5 e5] [g5 e5 ~ c5] [a4 c5 ~ ~] [e5 ~ a4 ~]>")
  .s("square")
  .lpf(4500)
  .attack(0.005)
  .decay(0.2)
  .sustain(0.15)
  .release(0.08)
  .delay(0.15)
  .delaytime(0.214)
  .delayfeedback(0.2)
  .gain(0.48)
  .room(0.25)
