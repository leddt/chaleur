[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/main_menu.gd" id="1_script"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.12, 0.14, 0.18, 1)

[node name="Center" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -200.0
offset_top = -130.0
offset_right = 200.0
offset_bottom = 130.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Center"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "Chaleur"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center"]
layout_mode = 2
text = "pédale su'l'coin d'la yeule"
horizontal_alignment = 1

[node name="PlayButton" type="Button" parent="Center"]
layout_mode = 2
text = "Partie locale (2J)"

[node name="LobbyButton" type="Button" parent="Center"]
layout_mode = 2
text = "Lobby réseau"

[node name="TrackEditorButton" type="Button" parent="Center"]
unique_name_in_owner = true
visible = false
layout_mode = 2
text = "Éditeur de piste"

[node name="QuitButton" type="Button" parent="Center"]
layout_mode = 2
text = "Quitter"

[connection signal="pressed" from="Center/PlayButton" to="." method="_on_play_pressed"]
[connection signal="pressed" from="Center/LobbyButton" to="." method="_on_lobby_pressed"]
[connection signal="pressed" from="Center/TrackEditorButton" to="." method="_on_track_editor_pressed"]
[connection signal="pressed" from="Center/QuitButton" to="." method="_on_quit_pressed"]
